# Include any files or directories that you don't want to be copied to your
# container here (e.g., local build artifacts, temporary files, etc.).
#
# For more help, visit the .dockerignore file reference guide at
# https://docs.docker.com/go/build-context-dockerignore/

**/.dockerignore
**/.env*
**/.git
**/.gitignore
**/.gitattributes
**/.project
**/.settings
**/.vscode
**/.cache
**/docker-compose*
**/compose.y*ml
**/compose.*.y*ml
**/Dockerfile*
**/node_modules
**/vendor
**/.DS_Store
.editorconfig
LICENSE
*.md

# The rest of .gitignore: Docker does not read it, so files that git ignores
# but that exist locally would otherwise be sent with the build context
**/*.log
.phpactor.json
.phpunit.result.cache
.phpunit.cache
.claude
.codex
.cursor
.idea
.nova
.zed
auth.json
database/*.sqlite*
public/fonts-manifest.dev.json
storage/*.key
storage/pail
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

tests/
phpunit.xml
phpunit.xml.dist

# Keep local runtime state out of the image
# The negation keeps the skeleton.
bootstrap/cache/*.php
storage/framework/*
storage/logs/*
storage/app/*
public/build
public/hot
public/storage
!storage/**/.gitignore
